# Port where the webhook relay server will listen
PORT=3000

# Optional Public App URL for generating "View Raw Payload" buttons
# If not specified, automatically inferred from incoming request Host & Protocol
# APP_URL=https://example.com

# ========================================================
# NOTIFICATION CHANNELS (Configure Discord, Lark, or both)
# ========================================================

# Discord Webhook URL (Discord Channel Settings -> Integrations -> Webhooks)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
# Optional Discord user or role ping (e.g. <@&123456789012345678>)
# DISCORD_MENTION=

# Lark / Feishu Custom Bot Webhook URL (Group Settings -> Bots -> Add Bot -> Custom Bot)
LARK_WEBHOOK_URL=https://open.larksuite.com/open-apis/bot/v2/hook/your_bot_token
# Optional Lark Bot Signature Secret (if Signature Verification is enabled on the bot)
# LARK_WEBHOOK_SECRET=your_lark_signature_secret
# Optional Lark mention (e.g. <at user_id="all">Everyone</at> or <at user_id="ou_xxx">Name</at>)
# LARK_MENTION=

# ========================================================
# 1. PAY-IN ENDPOINTS (Payment, Recurring, Binding)
# ========================================================
# Found in: Dashboard > Settings > Access Keys > Payment > Server Key
# Midtrans computes signature_key using the secret Server Key:
# SHA512(order_id + status_code + gross_amount + ServerKey)
MIDTRANS_SERVER_KEY=your_midtrans_server_key

# Verify Pay-in SHA-512 signature? (true/false)
VERIFY_LEGACY_SIGNATURE=true

# ========================================================
# 2. MIDTRANS IRIS (Disbursement / Payout - /iris)
# ========================================================
# Found in: Dashboard > Settings > Access Keys > Transfer > Merchant Key
# IRIS uses the dedicated Merchant Key (NOT the Server Key):
# SHA512(request_body + IRIS_MERCHANT_KEY)
IRIS_MERCHANT_KEY=your_iris_merchant_key

# Verify IRIS signature? (true/false)
VERIFY_IRIS_SIGNATURE=true

# ========================================================
# 3. BANK INDONESIA SNAP / OPEN API (/bi-snap/*)
# ========================================================
# Midtrans Public Key for verifying RSA-SHA256 asymmetric signature
# Found in: Dashboard > Settings > Payment > BI SNAP Notification URL
# Supports direct string in .env (multi-line or single-line) or file path
# MIDTRANS_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...\n-----END PUBLIC KEY-----"
MIDTRANS_PUBLIC_KEY_PATH=./keys/midtrans-public.pem

# Verify BI SNAP RSA-SHA256 signature? (true/false)
VERIFY_BI_SNAP_SIGNATURE=true

# ========================================================
# 4. NOTIFICATION & FEATURE PREFERENCES
# ========================================================
# Forward pending payments? (true/false)
# Set to 'false' if you only want alerts for paid/settled or failed orders
NOTIFY_ON_PENDING=true

# Enable "View Raw Payload" button & endpoint? (true/false, default: true)
ENABLE_RAW_VIEW=true
